{
    "$schema": "https://openapi.vercel.sh/vercel.schema.json",
    "framework": "nextjs",
    "regions": [
        "icn1"
    ],
    "functions": {
        "app/api/internal/kakao-signup-discord-outbox/route.ts": {
            "maxDuration": 60
        },
        "app/api/internal/sentry-discord-alert-outbox/route.ts": {
            "maxDuration": 60
        },
        "app/api/analysis/run/route.ts": {
            "maxDuration": 300
        },
        "app/api/analysis/step/route.ts": {
            "maxDuration": 300
        },
        "app/api/analysis/v2/worker/route.ts": {
            "maxDuration": 300
        },
        "app/api/analysis/v2/recover/route.ts": {
            "maxDuration": 300
        },
        "app/api/analysis/preflight/retention/route.ts": {
            "maxDuration": 60
        },
        "app/api/analysis/precheckout-blite/route.ts": {
            "maxDuration": 90
        }
    },
    "crons": [
        {
            "path": "/api/internal/kakao-signup-discord-outbox",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/internal/sentry-discord-alert-outbox",
            "schedule": "0 0 * * *"
        }
    ],
    "git": {
        "deploymentEnabled": {
            "main": true
        }
    }
}
